{
	"name": "dump-txt",
	"productName": "dump.txt",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": ".vite/build/main.cjs",
	"description": "A minimal paged scratchpad",
	"author": "Matt Cavender",
	"scripts": {
		"start": "electron-forge start",
		"build": "electron-forge package",
		"package": "electron-forge package",
		"make": "electron-forge make",
		"check": "concurrently --group \"prettier --check .\" \"eslint . --no-cache -f unix\" \"tsc --noEmit --pretty false\" \"stylelint \\\"**/*.css\\\" -f unix --allow-empty-input --cache\" \"markdownlint-cli2 \\\"**/*.md\\\"\" \"textlint -f compact \\\"**/*.md\\\"\" \"knip --no-progress\" \"jscpd .\" \"tsc --noEmit --pretty false -p tsconfig.node.json\"",
		"fix": "concurrently -m 1 --group \"prettier --write .\" \"eslint . --fix --cache\" \"stylelint \\\"**/*.css\\\" --fix --allow-empty-input --cache\" \"markdownlint-cli2 --fix \\\"**/*.md\\\"\" \"textlint --fix \\\"**/*.md\\\"\"",
		"unit": "vitest run unit",
		"integration": "vitest run integration",
		"prepare": "node -e \"const c=require('node:child_process');if(c.spawnSync('git',['rev-parse','--is-inside-work-tree'],{stdio:'ignore'}).status===0)c.execFileSync('git',['config','core.hooksPath','.githooks'])\" && node tools.mjs install"
	},
	"dependencies": {
		"@codemirror/commands": "6.11.0",
		"@codemirror/state": "6.7.4",
		"@codemirror/view": "6.43.11",
		"@radix-ui/react-dropdown-menu": "2.1.24",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"electron-squirrel-startup": "1.0.1",
		"events": "3.3.0",
		"lucide-react": "1.41.0",
		"opshot": "0.5.3",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "3.6.0",
		"write-file-atomic": "8.0.0",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@electron-forge/cli": "7.11.2",
		"@electron-forge/maker-squirrel": "7.11.2",
		"@electron-forge/plugin-auto-unpack-natives": "7.11.2",
		"@electron-forge/plugin-fuses": "7.11.2",
		"@electron-forge/plugin-vite": "7.11.2",
		"@electron-forge/shared-types": "7.11.2",
		"@electron/fuses": "1.8.0",
		"@eslint/compat": "2.1.1",
		"@eslint/js": "9.39.5",
		"@html-eslint/eslint-plugin": "0.65.0",
		"@stylistic/eslint-plugin": "5.10.0",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.7",
		"@types/electron-squirrel-startup": "1.0.2",
		"@types/node": "26.4.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@types/write-file-atomic": "4.0.3",
		"@vitejs/plugin-react": "6.1.1",
		"concurrently": "10.0.5",
		"electron": "44.2.0",
		"electron-winstaller": "5.4.4",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-formatter-unix": "9.0.1",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-barrel-files": "3.0.1",
		"eslint-plugin-comment-rules": "0.1.7",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"globals": "17.12.0",
		"jscpd": "5.1.2",
		"jsdom": "30.0.1",
		"knip": "6.34.0",
		"markdownlint-cli2": "0.23.2",
		"prettier": "3.9.6",
		"stylelint": "17.15.0",
		"stylelint-config-recommended": "18.0.0",
		"tailwindcss": "4.3.3",
		"textlint": "15.8.0",
		"textlint-filter-rule-comments": "1.3.0",
		"textlint-rule-no-dead-link": "6.2.3",
		"typescript": "6.0.3",
		"typescript-eslint": "8.69.0",
		"vite": "8.2.2",
		"vitest": "5.0.0"
	},
	"allowScripts": {
		"unrs-resolver@1.12.2": true,
		"electron-winstaller": false
	}
}
