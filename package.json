{
	"name": "dump-txt",
	"private": true,
	"type": "module",
	"packageManager": "npm@12.0.1",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"start": "turbo start --filter=@dump-txt/desktop --",
		"build": "turbo build --filter=@dump-txt/desktop --",
		"check": "concurrently --group \"prettier --check .\" \"turbo check\" \"eslint tools.mjs commitlint.config.mjs .githooks/pre-push.mjs --no-cache -f unix\" \"stylelint \\\"**/*.css\\\" -f unix --allow-empty-input --cache\" \"markdownlint-cli2 \\\"**/*.md\\\"\" \"textlint -f compact \\\"**/*.md\\\"\" \"knip --no-progress\" \"jscpd .\" \"node tools.mjs run actionlint\" \"check-dependency-version-consistency .\"",
		"fix": "concurrently -m 1 --group \"prettier --write .\" \"turbo fix\" \"eslint tools.mjs commitlint.config.mjs .githooks/pre-push.mjs --fix --cache\" \"stylelint \\\"**/*.css\\\" --fix --allow-empty-input --cache\" \"markdownlint-cli2 --fix \\\"**/*.md\\\"\" \"textlint --fix \\\"**/*.md\\\"\"",
		"unit": "turbo unit",
		"integration": "turbo integration",
		"tauri-test": "turbo tauri-test --",
		"prepare": "node -e \"const c=require('node:child_process');if(c.spawnSync('git',['rev-parse','--is-inside-work-tree'],{stdio:'ignore'}).status===0)c.execFileSync('git',['config','core.hooksPath','.githooks'])\" && node tools.mjs install && cargo install styling-lint --version 0.1.0 --locked && cargo install cargo-machete --version 0.9.2 --locked"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@eslint/compat": "2.1.1",
		"@eslint/js": "9.39.5",
		"@html-eslint/eslint-plugin": "0.65.0",
		"@stylistic/eslint-plugin": "5.10.0",
		"@types/node": "26.4.1",
		"check-dependency-version-consistency": "6.0.0",
		"concurrently": "10.0.5",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-formatter-unix": "9.0.1",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-barrel-files": "3.0.1",
		"eslint-plugin-comment-rules": "0.1.7",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-jsx-a11y": "6.10.2",
		"eslint-plugin-react": "7.37.5",
		"eslint-plugin-react-hooks": "7.1.1",
		"globals": "17.12.0",
		"jscpd": "5.1.2",
		"knip": "6.34.0",
		"markdownlint-cli2": "0.23.2",
		"prettier": "3.9.6",
		"stylelint": "17.15.0",
		"stylelint-config-recommended": "18.0.0",
		"textlint": "15.8.0",
		"textlint-filter-rule-comments": "1.3.0",
		"textlint-rule-no-dead-link": "6.2.3",
		"turbo": "2.10.12",
		"typescript": "6.0.3",
		"typescript-eslint": "8.69.0"
	},
	"allowScripts": {
		"fsevents@2.3.3": true,
		"unrs-resolver@1.12.2": true,
		"esbuild@0.28.2": true,
		"edgedriver": false,
		"geckodriver": false
	},
	"author": "Matt Cavender",
	"license": "MIT"
}
