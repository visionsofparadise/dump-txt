{
	"name": "@dump-txt/website",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "node tools/fetchRelease.mjs && vite --host 127.0.0.1",
		"release": "node tools/fetchRelease.mjs",
		"build": "vite build",
		"check": "concurrently --group \"eslint . --no-cache -f unix\" \"tsc --noEmit --pretty false\"",
		"fix": "eslint . --fix --cache",
		"unit": "vitest run src && node --test tools/*.unit.test.mjs"
	},
	"dependencies": {
		"@dump-txt/ui": "*",
		"@dump-txt/rig": "*",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@vitejs/plugin-react": "6.1.1",
		"vite": "8.2.2",
		"vitest": "5.0.0"
	},
	"license": "MIT",
	"author": "Matt Cavender"
}
