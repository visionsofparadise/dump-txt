{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [
		"package.json",
		"eslint.config.js",
		".gitignore",
		".prettierrc",
		".prettierignore",
		".stylelintrc.json",
		".markdownlint-cli2.jsonc",
		".textlintrc.json",
		".textlintignore",
		"knip.json",
		".jscpd.json",
		"tsconfig.json",
		"rust-toolchain.toml",
		"rustfmt.toml",
		"tools.json"
	],
	"globalEnv": [
		"OS",
		"RUNNER_OS",
		"RUNNER_ARCH",
		"ImageOS",
		"ImageVersion",
		"PROCESSOR_ARCHITECTURE",
		"DUMP_TXT_PROFILE",
		"RUSTFLAGS",
		"CARGO_BUILD_TARGET"
	],
	"globalPassThroughEnv": [
		"CARGO_BUILD_JOBS",
		"CARGO_HOME",
		"RUSTUP_HOME",
		"TAURI_*",
		"DUMP_TXT_*",
		"MS_EDGE_DRIVER",
		"DISPLAY",
		"WAYLAND_DISPLAY",
		"XAUTHORITY",
		"DBUS_SESSION_BUS_ADDRESS",
		"XDG_*"
	],
	"tasks": {
		"check": {
			"dependsOn": ["^check"],
			"inputs": ["$TURBO_DEFAULT$"],
			"outputs": []
		},
		"fix": {
			"cache": false
		},
		"build": {
			"dependsOn": ["^build", "check"],
			"cache": false
		},
		"unit": {
			"dependsOn": ["check"],
			"cache": false
		},
		"integration": {
			"dependsOn": ["check"],
			"cache": false
		},
		"@dump-txt/app#integration": {
			"dependsOn": [
				"check",
				"@dump-txt/ui#integration",
				"@dump-txt/rig#integration",
				"@dump-txt/website#integration"
			],
			"cache": false
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"tauri-test": {
			"cache": false
		},
		"@dump-txt/app#release": {
			"cache": true,
			"inputs": [
				"$TURBO_DEFAULT$",
				"!src/**/*.test.*",
				"!tools/test*",
				"!tools/*.unit.test.mjs",
				"../../packages/ui/**",
				"!../../packages/ui/**/*.test.*",
				"!../../packages/ui/node_modules/**",
				"!../../packages/ui/.turbo/**",
				"!../../packages/ui/**/*.tsbuildinfo",
				"../../package-lock.json"
			],
			"outputs": ["out/make/**"]
		}
	}
}
