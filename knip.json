{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": [".githooks/pre-push.mjs", "sweep.mjs"],
			"ignoreDependencies": [
				"prettier",
				"@commitlint/cli",
				"textlint-filter-rule-comments",
				"textlint-rule-no-dead-link"
			]
		},
		"apps/app": {
			"project": ["src/**/*.{ts,tsx,css}", "*.config.ts"],
			"entry": ["tools/*.mjs"],
			"vite": {
				"config": ["vite.*.config.ts"]
			},
			"ignoreDependencies": ["events"]
		},
		"packages/ui": {
			"project": ["src/**/*.{ts,tsx,css}", "*.config.ts"],
			"ignoreDependencies": ["events"]
		},
		"apps/gif": {
			"entry": ["tools/*.mjs"],
			"project": ["src/**/*.{ts,tsx,css}"]
		},
		"apps/website": {
			"entry": ["tools/*.mjs", "src/app/index.tsx"],
			"project": ["src/**/*.{ts,tsx,css}"]
		},
		"packages/rig": {
			"project": ["src/**/*.{ts,tsx}"]
		}
	},
	"ignoreBinaries": ["styling-lint", "ffmpeg"]
}
